{
  "name": "orvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:local": "eve build && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "owner:create": "node --env-file=.env.local --import tsx scripts/create-owner.ts",
    "setup:test": "node scripts/setup-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@vercel/blob": "^2.7.0",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "eve": "0.80.1",
    "just-bash": "^3.6.0",
    "kysely": "^0.29.7",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
