# Production: Node.js 24+, PostgreSQL; секреты задаются через окружение размещения.
DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
ORVO_RUNTIME_SECRET=
ORVO_RUNTIME_URL=http://127.0.0.1:3000
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# Private S3-compatible bucket for attachments. Do not expose credentials to client.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for isolated local tests; never enable in a cloud production environment.
ORVO_TEST_MODE=0
