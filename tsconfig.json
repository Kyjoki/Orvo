{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, "skipLibCheck": true, "strict": true, "noEmit": true,
    "esModuleInterop": true, "module": "esnext", "moduleResolution": "bundler",
    "resolveJsonModule": true, "isolatedModules": true, "jsx": "react-jsx",
    "incremental": true, "plugins": [{"name":"next"}],
    "types": ["node", "eve/workflow-modules"],
    "paths": {"@/*":["./src/*"]}
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "agent/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "evals/**/*.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
